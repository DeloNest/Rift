<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Rift.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0E0E10</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Rift</item>
    </style>

    <style name="Theme.Rift" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0E0E10</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
